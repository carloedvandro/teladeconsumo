# =============================================================================
# Vivo Gestão de Linhas — variáveis de ambiente (raiz)
# =============================================================================
# Copie para .env e preencha. Gere senhas/chaves fortes.
# =============================================================================

# ---- Supabase self-host (herdadas do .env do supabase-selfhost) ----
# IMPORTANTE: copie também o conteúdo de supabase-selfhost/.env para CÁ,
# ou mantenha os dois .env sincronizados. As chaves abaixo são as mínimas.
POSTGRES_PASSWORD=troque-por-uma-senha-forte-e-longa
JWT_SECRET=troque-por-um-jwt-secret-de-32-caracteres-no-minimo
ANON_KEY=
SERVICE_ROLE_KEY=
SITE_URL=http://SEU_VPS:3000
API_EXTERNAL_URL=http://SEU_VPS:8000
STUDIO_DEFAULT_ORGANIZATION=Vivo Gestao
STUDIO_DEFAULT_PROJECT=Linhas
# Gerar com: openssl rand -base64 32
SECRET_KEY_BASE=
VAULT_ENC_KEY=
POOLER_TENANT_ID=
POOLER_DEFAULT_POOL_SIZE=
POOLER_MAX_CLIENT_CONN=
POOLER_DB_POOL_SIZE=

# ---- App (web) ----
# URL que o navegador do cliente usa pra falar com o Supabase (público).
VITE_SUPABASE_URL=http://SEU_VPS_OU_DOMINIO:8000
VITE_SUPABASE_PUBLISHABLE_KEY=${ANON_KEY}
VITE_VAPID_PUBLIC_KEY=

# ---- Scraper Vivo ----
VIVO_PORTAL_USER=
VIVO_PORTAL_PASS=
VIVO_PORTAL_URL=https://login.vivo.com.br/login
SCRAPER_INTERVAL_SEC=300

# ---- Push notifications (VAPID) ----
# Gerar UMA vez: docker compose --profile keys run --rm scraper python scraper/gen_vapid_keys.py
# (ou localmente: python scraper/gen_vapid_keys.py)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com
